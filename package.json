{
  "name": "khayt",
  "version": "3.7.0",
  "description": "Khayt - 3D printing production management, invoicing and analytics. Free and open to all makers worldwide.",
  "main": "main.js",
  "author": {
    "name": "Khayt",
    "email": "support@khaytapp.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": false,
  "scripts": {
    "lint": "node scripts/lint-syntax.js && node scripts/check-locale-files.js",
    "i18n:extract": "node scripts/extract-i18n-locales.js",
    "branches:stale": "node scripts/list-stale-branches.mjs",
    "check": "npm run lint && npm test",
    "test": "node --test test/*.test.js",
    "test:future": "node scripts/test-future.mjs",
    "pretest:e2e": "node scripts/ensure-electron.js",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:e2e:all": "node scripts/e2e-all.mjs",
    "test:e2e:themes": "node scripts/e2e-theme-shells.mjs",
    "test:e2e:bedready": "node scripts/e2e-bedready-smoke.mjs",
    "test:e2e:qc": "node scripts/e2e-qc-smoke.mjs",
    "test:e2e:orgview": "node scripts/e2e-org-overview.mjs",
    "test:e2e:printers": "node scripts/e2e-printer-catalog-smoke.mjs",
    "test:e2e:shipping": "node scripts/e2e-shipping-smoke.mjs",
    "test:e2e:bom": "node scripts/e2e-bom-smoke.mjs",
    "test:e2e:consumables": "node scripts/e2e-consumable-reorder-smoke.mjs",
    "test:e2e:help": "node scripts/e2e-help-menu.mjs",
    "verify:estimator": "node scripts/verify-estimator.mjs",
    "test:e2e:privacy": "node scripts/e2e-privacy-smoke.mjs",
    "test:e2e:3mfworker": "node scripts/e2e-3mf-worker.mjs",
    "test:e2e:assembly": "node scripts/e2e-assembly-smoke.mjs",
    "test:e2e:apitokens": "node scripts/e2e-api-tokens-smoke.mjs",
    "test:e2e:webhooks": "node scripts/e2e-webhook-bus-smoke.mjs",
    "test:e2e:telemetry": "node scripts/e2e-telemetry-smoke.mjs",
    "test:e2e:webhookretry": "node scripts/e2e-webhook-durable-smoke.mjs",
    "prestart": "node scripts/ensure-electron.js",
    "start": "electron .",
    "install:electron": "node scripts/install-electron-await.js",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "version:beta": "node scripts/bump-version.js beta",
    "pack": "electron-builder --dir",
    "dist:mac:arm64": "electron-builder --mac --arm64",
    "dist:mac:x64": "electron-builder --mac --x64",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64",
    "prestart:bedready": "node scripts/ensure-electron.js",
    "start:bedready": "KHAYT_FLAVOR=bedready electron .",
    "pack:bedready": "node scripts/build-bedready.mjs --dir",
    "dist:bedready:mac:arm64": "node scripts/build-bedready.mjs --mac --arm64",
    "dist:bedready:win": "node scripts/build-bedready.mjs --win --x64",
    "dist:bedready:linux": "node scripts/build-bedready.mjs --linux --x64",
    "build:icons": "python3 make_icon.py && python3 scripts/build-appx-icons.py",
    "wire:logo": "python3 scripts/wire-logo-exports.py",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "publish:screenshots": "node scripts/publish-screenshots.mjs",
    "fonts:vendor": "node scripts/vendor-theme-fonts.mjs",
    "capture:theme-previews": "node scripts/capture-theme-previews.mjs",
    "capture:website": "node scripts/capture-website-screenshots.mjs",
    "capture:bedready": "node scripts/capture-bedready-screenshots.mjs",
    "capture:modes": "node scripts/capture-mode-showcase.mjs",
    "test:e2e:discovery": "node scripts/e2e-discovery-smoke.mjs",
    "test:e2e:quitflush": "node scripts/e2e-quit-flush-smoke.mjs",
    "test:e2e:screens": "node scripts/e2e-populated-screens-smoke.mjs",
    "test:ios-contract": "bash scripts/ios-contract.sh",
    "test:e2e:a11y": "node scripts/e2e-a11y-keyboard.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:e2e:intake": "node scripts/e2e-model-intake-smoke.mjs",
    "test:e2e:intakequote": "node scripts/e2e-intake-quote-smoke.mjs",
    "test:e2e:actuals": "node scripts/e2e-measured-actuals-smoke.mjs",
    "check:changelog": "node scripts/check-changelog.js",
    "check:release-claims": "node scripts/check-release-claims.js",
    "check:globals": "node scripts/check-globals-loaded.js renderer/index.html renderer/bedready.html",
    "test:e2e:pollcache": "node scripts/e2e-poll-cache.mjs",
    "test:e2e:backupsize": "node scripts/e2e-backup-size.mjs",
    "test:e2e:recovery": "node scripts/e2e-recovery-honesty.mjs",
    "test:e2e:setups": "node scripts/e2e-print-setups-smoke.mjs",
    "test:e2e:multipart": "node scripts/e2e-multi-part-print-smoke.mjs",
    "test:e2e:organise": "node scripts/e2e-organise-smoke.mjs",
    "test:e2e:bulk": "node scripts/e2e-bulk-actions-smoke.mjs",
    "test:e2e:package": "node scripts/e2e-package-a-group-smoke.mjs",
    "test:e2e:biglib": "node scripts/e2e-big-library-smoke.mjs",
    "test:e2e:consent": "node scripts/e2e-update-consent-smoke.mjs",
    "test:e2e:dedupe": "node scripts/e2e-model-dedupe-smoke.mjs",
    "test:e2e:filelink": "node scripts/e2e-order-file-link-smoke.mjs",
    "test:e2e:estimator": "node scripts/e2e-estimator-settings-smoke.mjs",
    "test:e2e:david": "node scripts/e2e-david-items.mjs",
    "test:e2e:tax": "node scripts/e2e-tax.mjs",
    "test:e2e:upgradebackup": "node scripts/e2e-upgrade-backup.mjs",
    "test:e2e:invlang": "node scripts/e2e-invoice-language.mjs",
    "verify:printer": "node scripts/verify-printer-actuals.mjs",
    "test:e2e:clipboard": "node scripts/e2e-clipboard-smoke.mjs",
    "test:e2e:cloudplans": "node scripts/e2e-cloud-plans-smoke.mjs",
    "store:metadata": "node scripts/build-store-metadata.mjs",
    "store:check": "node scripts/build-store-metadata.mjs --check",
    "store:manual": "node scripts/build-store-metadata.mjs --manual",
    "capture:store-screenshots": "node scripts/capture-store-screenshots.mjs",
    "test:e2e:cloudstorage": "node scripts/e2e-cloud-storage-smoke.mjs",
    "test:e2e:cloudsignup": "node scripts/e2e-cloud-signup-smoke.mjs",
    "test:e2e:productimages": "node scripts/e2e-product-images-smoke.mjs"
  },
  "dependencies": {
    "@sentry/electron": "^7.16.0",
    "electron-updater": "^6.8.9",
    "localtunnel": "^2.0.2",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@fontsource/albert-sans": "^5.2.8",
    "@fontsource/archivo": "^5.2.8",
    "@fontsource/bricolage-grotesque": "^5.2.10",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.9",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/newsreader": "^5.2.10",
    "@fontsource/outfit": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@fontsource/spline-sans-mono": "^5.2.8",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.60.0"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "overrides": {
    "localtunnel": {
      "axios": "1.18.1",
      "debug": "4.4.3"
    },
    "axios": {
      "follow-redirects": "1.16.0"
    },
    "tmp": "0.2.7",
    "form-data": "^4.0.6",
    "js-yaml": "4.3.2",
    "fast-uri": "^3.1.7"
  },
  "build": {
    "appId": "app.khayt.hub",
    "productName": "Khayt",
    "publish": {
      "provider": "github",
      "owner": "khaytapp",
      "repo": "Khayt"
    },
    "directories": {
      "output": "build",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Khayt ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Khayt"
    },
    "appx": {
      "applicationId": "Khayt",
      "backgroundColor": "#0F172A",
      "showNameOnTiles": false,
      "languages": [
        "en-US"
      ],
      "publisherDisplayName": "Khayt",
      "identityName": "Khayt.Khayt",
      "publisher": "CN=F9AECB56-B63C-4BD8-BAF1-B8CDA4A8B0BC"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon_preview.png",
      "category": "Office",
      "description": "3D printing production management, invoicing & analytics"
    }
  }
}
