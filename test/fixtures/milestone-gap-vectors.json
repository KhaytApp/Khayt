{
  "about": "lib/payment-reminder.js milestoneGap / refreshedMilestones / differenceProforma (Turki, Nov 17 2026): after a job is re-priced, an ISSUED milestone proforma stays as sent and an updated proforma is offered for the difference; an unissued one follows the price. `want.gap` is milestoneGap's {stale, issuedDiff, unissuedDiff, rows: [[id, expected, diff, issued]]}; `want.refreshed` the amounts after refreshedMilestones; `want.difference` differenceProforma(order, `differenceFor`, {id: 'MS-NEW'}) or null. Every app runs these.",
  "cases": [
    { "why": "price up 100 to 200: the issued deposit is short 50 (a difference proforma), the unissued balance follows", "order": { "price": 200, "milestoneInvoices": [{ "id": "M1", "label": "Deposit", "percentage": 50, "amount": 50, "issuedAt": "2026-11-10" }, { "id": "M2", "label": "On delivery", "percentage": 50, "amount": 50, "issuedAt": null }] }, "differenceFor": "M1", "want": { "gap": { "stale": true, "issuedDiff": 50, "unissuedDiff": 50, "rows": [["M1", 100, 50, true], ["M2", 100, 50, false]] }, "refreshed": [50, 100], "difference": { "id": "MS-NEW", "label": "Deposit", "percentage": null, "amount": 50, "issuedAt": null, "kind": "difference", "forMilestoneId": "M1" } } },
    { "why": "price down 200 to 150: the issued deposit asks for 25 more than its share; no automatic row", "order": { "price": 150, "milestoneInvoices": [{ "id": "M1", "label": "Deposit", "percentage": 50, "amount": 100, "issuedAt": "2026-11-10" }, { "id": "M2", "label": "Rest", "percentage": 50, "amount": 100 }] }, "differenceFor": "M1", "want": { "gap": { "stale": true, "issuedDiff": -25, "unissuedDiff": -25, "rows": [["M1", 75, -25, true], ["M2", 75, -25, false]] }, "refreshed": [100, 75], "difference": null } },
    { "why": "a difference proforma already raised closes the issued gap", "order": { "price": 200, "milestoneInvoices": [{ "id": "M1", "label": "Deposit", "percentage": 50, "amount": 50, "issuedAt": "2026-11-10" }, { "id": "D1", "label": "Deposit", "percentage": null, "amount": 50, "kind": "difference", "forMilestoneId": "M1" }, { "id": "M2", "label": "Rest", "percentage": 50, "amount": 100 }] }, "differenceFor": "M1", "want": { "gap": { "stale": false, "issuedDiff": 0, "unissuedDiff": 0, "rows": [] }, "refreshed": [50, 50, 100], "difference": null } },
    { "why": "rows typed as an amount say nothing about a share and are left alone", "order": { "price": 500, "milestoneInvoices": [{ "id": "M1", "label": "Fixed", "amount": 100, "issuedAt": "2026-11-10" }] }, "differenceFor": "M1", "want": { "gap": { "stale": false, "issuedDiff": 0, "unissuedDiff": 0, "rows": [] }, "refreshed": [100], "difference": null } },
    { "why": "the price did not move: nothing is stale", "order": { "price": 333.33, "milestoneInvoices": [{ "id": "M1", "label": "A", "percentage": 33.33, "amount": 111.1, "issuedAt": "2026-11-10" }, { "id": "M2", "label": "B", "percentage": 66.67, "amount": 222.23 }] }, "differenceFor": "M1", "want": { "gap": { "stale": false, "issuedDiff": 0, "unissuedDiff": 0, "rows": [] }, "refreshed": [111.1, 222.23], "difference": null } },
    { "why": "an unissued milestone has no difference proforma: it is simply updated", "order": { "price": 300, "milestoneInvoices": [{ "id": "M1", "label": "Deposit", "percentage": 30, "amount": 60 }] }, "differenceFor": "M1", "want": { "gap": { "stale": true, "issuedDiff": 0, "unissuedDiff": 30, "rows": [["M1", 90, 30, false]] }, "refreshed": [90], "difference": null } }
  ]
}
