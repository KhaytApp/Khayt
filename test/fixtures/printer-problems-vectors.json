   "want": [
    {
     "code": "door-open",
     "severity": "common",
     "action": "close-door",
     "source": "bambu",
     "ref": "0300_800F"
    }
   ]
  },
  {
   "why": "bambu: an unknown code on a stopped job is printer-error with its code to look up",
   "type": "bambu",
   "report": {
    "gcode_state": "FAILED",
