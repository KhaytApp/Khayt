{
 "about": "lib/printer-problems.js problemsFor(type, report): one closed problem list for every protocol (C3). Bambu codes as the printer packs them (print_error int, hms attr/code ints); the U1 row in the shape the shop's U1 reported; the rest synthetic, in each adapter's normalised status. The Mac and iPhone run these through JSC.",
 "cases": [
  {
   "why": "bambu: a runout pause is filament-runout, load filament",
   "type": "bambu",
   "report": {
    "gcode_state": "PAUSE",
    "print_error": 50364420
   },
   "want": [
    {
     "code": "filament-runout",
     "severity": "serious",
     "action": "load-filament",
     "source": "bambu",
     "ref": "0300_8004"
    }
   ]
  },
  {
   "why": "bambu: an HMS nozzle over-temperature is fatal, check the heater",
   "type": "bambu",
   "report": {
    "gcode_state": "RUNNING",
    "hms": [
     {
      "attr": 50332160,
      "code": 65539
     }
    ]
   },
   "want": [
    {
     "code": "temperature",
     "severity": "fatal",
     "action": "check-heater",
     "source": "bambu",
     "ref": "HMS_0300_0200_0001_0003"
    }
   ]
  },
  {
   "why": "bambu: a cancelled task is info, nothing to do",
