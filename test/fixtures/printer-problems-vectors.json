   "report": {
    "gcode_state": "FAILED",
    "print_error": 50348044
   },
   "want": [
    {
     "code": "print-cancelled",
     "severity": "info",
     "action": "none",
     "source": "bambu",
     "ref": "0300_400C"
    }
   ]
  },
  {
   "why": "bambu: the door open while printing",
   "type": "bambu",
   "report": {
    "gcode_state": "PAUSE",
