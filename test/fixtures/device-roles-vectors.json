{
 "about": "lib/device-roles.js allows(role, path, method) for a paired phone (C1+C9, D-P4 as decided Nov 22). required: a scope, null (any paired device) or 'owner' (only the owner). The Mac and iPhone run this file through JavaScriptCore. Paths are percent-decoded per segment; a segment that decodes to '/', '\\\\', a control, '.' or '..' (or does not decode) is owner-only. GET/HEAD read, POST/PATCH/PUT/DELETE write, anything else owner-only. Case-sensitive, as the servers route.",
 "roles": [
  "owner",
  "manager",
  "operator",
  "viewer"
 ],
 "scopesFor": {
  "viewer": [
   "queue:read",
   "machines:read",
   "orders:read",
   "inventory:read"
  ],
  "operator": [
   "queue:read",
   "machines:read",
   "orders:read",
   "inventory:read",
   "orders:write",
   "inventory:write",
   "waste:write",
   "machines:control"
  ],
  "manager": [
   "queue:read",
   "machines:read",
   "orders:read",
   "inventory:read",
   "orders:write",
   "inventory:write",
   "waste:write",
   "machines:control",
   "clients:read",
   "clients:write",
   "expense:write",
   "quote:write",
   "book:read"
  ]
 },
