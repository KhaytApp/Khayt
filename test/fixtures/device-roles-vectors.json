 "cases": [
  {
   "why": "a viewer reads the queue",
   "role": "viewer",
   "path": "/api/queue",
   "method": "GET",
   "want": {
    "ok": true,
    "required": "queue:read",
    "role": "viewer"
   }
  },
  {
   "why": "a viewer cannot pause a printer",
   "role": "viewer",
   "path": "/api/printer/m1/pause",
   "method": "POST",
   "want": {
    "ok": false,
    "required": "machines:control",
    "role": "viewer"
   }
  },
  {
   "why": "an operator may pause, resume and stop (D-P4)",
   "role": "operator",
   "path": "/api/printer/m1/pause",
   "method": "POST",
   "want": {
    "ok": true,
    "required": "machines:control",
    "role": "operator"
   }
  },
  {
   "why": "an operator may stop",
   "role": "operator",
   "path": "/api/printer/m1/stop",
   "method": "POST",
   "want": {
    "ok": true,
    "required": "machines:control",
    "role": "operator"
   }
  },
  {
   "why": "an operator moves a job's stage",
   "role": "operator",
   "path": "/api/orders/a1b2",
   "method": "PATCH",
   "want": {
    "ok": true,
    "required": "orders:write",
    "role": "operator"
   }
  },
  {
   "why": "an operator adds a job photo",
   "role": "operator",
   "path": "/api/orders/a1b2/photos",
   "method": "POST",
   "want": {
    "ok": true,
    "required": "orders:write",
    "role": "operator"
   }
  },
  {
   "why": "an operator cannot read customers",
   "role": "operator",
   "path": "/api/clients",
   "method": "GET",
   "want": {
    "ok": false,
    "required": "clients:read",
    "role": "operator"
   }
  },
  {
   "why": "an operator cannot approve a quote for a customer",
   "role": "operator",
   "path": "/api/orders/a1b2/approve",
   "method": "POST",
   "want": {
    "ok": false,
    "required": "quote:write",
    "role": "operator"
   }
  },
  {
   "why": "an operator cannot take the book",
   "role": "operator",
   "path": "/api/store",
   "method": "GET",
   "want": {
    "ok": false,
    "required": "book:read",
    "role": "operator"
   }
  },
  {
   "why": "an operator logs waste",
   "role": "operator",
   "path": "/api/waste",
   "method": "POST",
   "want": {
    "ok": true,
    "required": "waste:write",
    "role": "operator"
   }
  },
  {
   "why": "an operator cannot log an expense",
   "role": "operator",
   "path": "/api/expense",
   "method": "POST",
   "want": {
    "ok": false,
    "required": "expense:write",
    "role": "operator"
   }
  },
  {
   "why": "a manager takes a local copy of the book",
   "role": "manager",
   "path": "/api/store",
   "method": "GET",
   "want": {
    "ok": true,
    "required": "book:read",
    "role": "manager"
   }
  },
  {
   "why": "a manager cannot write the book back",
   "role": "manager",
   "path": "/api/store/deltas",
   "method": "POST",
   "want": {
    "ok": false,
    "required": "book:write",
    "role": "manager"
   }
  },
  {
   "why": "a manager prices a library model",
   "role": "manager",
   "path": "/api/library/x9/estimate",
   "method": "POST",
   "want": {
    "ok": true,
    "required": "quote:write",
    "role": "manager"
   }
  },
  {
   "why": "the owner writes the book",
   "role": "owner",
   "path": "/api/store/deltas",
   "method": "POST",
   "want": {
    "ok": true,
    "required": "book:write",
    "role": "owner"
   }
  },
  {
   "why": "a route the table does not name: only the owner",
   "role": "manager",
   "path": "/api/files/local",
   "method": "POST",
   "want": {
    "ok": false,
    "required": "owner",
    "role": "manager"
   }
  },
  {
   "why": "the owner may use a route the table does not name",
   "role": "owner",
   "path": "/api/files/local",
   "method": "POST",
   "want": {
    "ok": true,
    "required": "owner",
    "role": "owner"
   }
  },
  {
   "why": "a direction a route does not offer a phone: only the owner",
   "role": "manager",
   "path": "/api/clients",
   "method": "POST",
   "want": {
    "ok": false,
    "required": "owner",
    "role": "manager"
   }
  },
  {
   "why": "any paired device asks who it is",
   "role": "viewer",
   "path": "/api/devices/self",
   "method": "GET",
   "want": {
    "ok": true,
    "required": null,
    "role": "viewer"
   }
  },
  {
   "why": "the /v1 prefix is the same route",
   "role": "viewer",
   "path": "/v1/orders?since=5",
   "method": "GET",
   "want": {
    "ok": true,
    "required": "orders:read",
    "role": "viewer"
   }
  },
  {
   "why": "the servers route case-sensitively: an upper-case path is no route, so owner-only",
   "role": "viewer",
   "path": "/API/Queue",
   "method": "GET",
   "want": {
    "ok": false,
    "required": "owner",
    "role": "viewer"
   }
  },
  {
   "why": "a path outside the API: only the owner",
   "role": "manager",
   "path": "/order/abc",
   "method": "GET",
   "want": {
    "ok": false,
    "required": "owner",
    "role": "manager"
   }
  },
  {
   "why": "an unknown role is a viewer",
   "role": "superuser",
   "path": "/api/printer/m1/stop",
   "method": "POST",
   "want": {
    "ok": false,
    "required": "machines:control",
    "role": "viewer"
   }
  },
  {
   "why": "waiting list writes are customers' business",
   "role": "operator",
   "path": "/api/waiting-list/w1",
   "method": "PATCH",
   "want": {
    "ok": false,
    "required": "clients:write",
    "role": "operator"
   }
  },
  {
   "why": "an empty id segment does not match a route with one",
   "role": "viewer",
   "path": "/api/orders//photos",
   "method": "POST",
   "want": {
    "ok": false,
    "required": "owner",
    "role": "viewer"
   }
  },
  {
   "why": "%2F inside an id cannot reach approve (reviews of #2625)",
   "role": "operator",
   "path": "/api/orders/x%2Fapprove",
   "method": "POST",
   "want": {
    "ok": false,
    "required": "owner",
    "role": "operator"
   }
  },
  {
   "why": "%2f, lower case, the same",
   "role": "viewer",
   "path": "/api/orders/x%2fquote-url",
   "method": "GET",
   "want": {
    "ok": false,
    "required": "owner",
    "role": "viewer"
   }
  },
  {
   "why": "a backslash inside an id cannot climb to the book",
   "role": "operator",
   "path": "/api/orders/x\\..\\..\\store\\deltas",
   "method": "POST",
   "want": {
    "ok": false,
    "required": "owner",
    "role": "operator"
   }
  },
  {
   "why": "a dot segment is not routed on",
   "role": "viewer",
   "path": "/api/orders/..",
   "method": "GET",
   "want": {
    "ok": false,
    "required": "owner",
    "role": "viewer"
   }
  },
  {
   "why": "an encoded dot segment either",
   "role": "viewer",
   "path": "/api/orders/%2e%2e",
   "method": "GET",
   "want": {
    "ok": false,
    "required": "owner",
    "role": "viewer"
   }
  },
  {
   "why": "bad percent-encoding is not routed on",
   "role": "viewer",
   "path": "/api/orders/%E0%A4%A",
   "method": "GET",
   "want": {
    "ok": false,
    "required": "owner",
    "role": "viewer"
   }
  },
  {
   "why": "an encoded control character is not routed on",
   "role": "viewer",
   "path": "/api/orders/a%00b",
   "method": "GET",
   "want": {
    "ok": false,
    "required": "owner",
    "role": "viewer"
   }
  },
  {
   "why": "an ordinary encoded id still matches",
   "role": "operator",
   "path": "/api/orders/o%5F123",
   "method": "PATCH",
   "want": {
    "ok": true,
    "required": "orders:write",
    "role": "operator"
   }
  },
  {
   "why": "HEAD is a read",
   "role": "viewer",
   "path": "/api/queue",
   "method": "HEAD",
   "want": {
    "ok": true,
    "required": "queue:read",
    "role": "viewer"
   }
  },
  {
   "why": "OPTIONS is owner-only",
   "role": "viewer",
   "path": "/api/queue",
   "method": "OPTIONS",
   "want": {
    "ok": false,
    "required": "owner",
    "role": "viewer"
   }
  },
  {
   "why": "an unknown verb is owner-only",
   "role": "manager",
   "path": "/api/orders/a1",
   "method": "PROPFIND",
   "want": {
    "ok": false,
    "required": "owner",
    "role": "manager"
   }
  },
  {
   "why": "a manager fetches a library thumbnail (the servers' word is thumb)",
   "role": "manager",
   "path": "/api/library/PF-1/thumb",
   "method": "GET",
   "want": {
    "ok": true,
    "required": "quote:write",
    "role": "manager"
   }
  },
  {
   "why": "the Mac's cancel is stop's scope",
   "role": "operator",
   "path": "/api/printer/m1/cancel",
   "method": "POST",
   "want": {
    "ok": true,
    "required": "machines:control",
    "role": "operator"
   }
  },
  {
   "why": "a trailing slash is the same route",
   "role": "viewer",
   "path": "/api/queue/",
   "method": "GET",
   "want": {
    "ok": true,
    "required": "queue:read",
    "role": "viewer"
   }
  }
 ],
