      },
      "next": {
        "nonBusiness": true
      },
      "want": {
        "ok": false,
        "reason": "zatca",
        "step": "business"
      }
    },
    {
      "why": "a voided job: refused as frozen",
      "order": {
        "id": "J5",
        "status": "pending",
        "price": 100,
        "voidedAt": "2026-11-13T09:00:00Z"
      },
      "next": {
        "nonBusiness": true
      },
      "want": {
        "ok": false,
        "reason": "voided",
        "step": "business"
      }
    },
    {
      "why": "a cancelled job: refused as frozen",
      "order": {
        "id": "J6",
        "status": "cancelled",
        "price": 100
      },
      "next": {
        "nonBusiness": true
      },
      "want": {
        "ok": false,
        "reason": "cancelled",
        "step": "business"
      }
    },
    {
