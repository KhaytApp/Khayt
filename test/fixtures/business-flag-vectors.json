{
  "about": "lib/order-edit.js applyJobEdit and the not-business flag (Dev Hub, Nov 18). Once a tax invoice is issued VAT is due, so the revenue is reported and the flag no longer moves, either way; nor on a frozen job. Before an invoice it is the shop's to set. The Mac and the phone run this file. Decision A (Dev Hub, Nov 18): an issued invoice whose total is ZERO (price net of credit notes 0) moves no revenue and no VAT, so the flag may move; frozen jobs stay refused regardless.",
  "cases": [
    {
      "why": "a quote may be marked not business",
      "order": {
        "id": "Q1",
        "status": "quote",
        "price": 100
      },
      "next": {
        "nonBusiness": true
      },
      "want": {
        "ok": true,
        "nonBusiness": true
      }
    },
    {
      "why": "and unmarked again",
      "order": {
        "id": "Q2",
        "status": "quote",
        "price": 100,
        "nonBusiness": true
      },
      "next": {
        "nonBusiness": false
      },
      "want": {
        "ok": true,
        "nonBusiness": false
      }
    },
    {
      "why": "a quote on hold awaiting the customer's yes has no invoice yet",
      "order": {
        "id": "Q3",
        "status": "on_hold",
        "hasQuote": true,
        "price": 100
      },
      "next": {
        "nonBusiness": true
      },
      "want": {
        "ok": true,
        "nonBusiness": true
      }
    },
    {
      "why": "a booked job has an issued invoice: refused",
      "order": {
        "id": "J1",
        "status": "pending",
        "price": 100
      },
      "next": {
        "nonBusiness": true
      },
      "want": {
        "ok": false,
        "reason": "invoice_issued",
        "step": "business"
      }
    },
    {
      "why": "a finished job: refused",
      "order": {
        "id": "J2",
        "status": "completed",
        "price": 100
      },
      "next": {
        "nonBusiness": true
      },
      "want": {
        "ok": false,
        "reason": "invoice_issued",
        "step": "business"
      }
    },
    {
      "why": "taking the flag OFF a booked not-business job would put revenue into a reported period: refused too",
      "order": {
        "id": "J3",
        "status": "pending",
        "price": 100,
        "nonBusiness": true
      },
      "next": {
        "nonBusiness": false
      },
      "want": {
        "ok": false,
        "reason": "invoice_issued",
        "step": "business"
      }
    },
    {
