      "local": {
        "name": "Bracket",
        "colors": [
          {
            "hex": "#111111"
          }
        ],
        "coloursReader": 3
      },
      "incoming": {
        "name": "Bracket",
        "colors": [
          {
            "hex": "#222222"
          }
        ],
        "coloursReader": 4
      },
      "keep": "incoming",
      "conflict": false
    },
    {
