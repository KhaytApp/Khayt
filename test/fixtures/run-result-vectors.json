     },
     "changed": true
    }
   ],
   "want": [
    {
     "machineId": "M1",
     "at": "2026-11-18T08:00:00Z",
     "started": true
    },
    {
     "machineId": "M2",
     "at": "2026-11-18T09:00:00Z",
     "started": true,
     "result": "failed",
     "resultSource": "shop",
     "printerResult": "cancelled"
    },
    {
     "machineId": "M1",
     "at": "2026-11-18T12:00:00Z",
     "started": true
    }
   ]
  },
  {
   "why": "the earlier run is found by time, not by being last",
   "steps": [
    {
