   ],
   "want": [
    {
     "machineId": "M1",
     "at": "2026-11-18T08:00:00Z",
     "started": true,
     "result": "cancelled",
     "resultSource": "printer",
     "printerResult": "cancelled"
    },
    {
     "machineId": "M2",
     "at": "2026-11-18T09:00:00Z",
     "started": true
    },
    {
     "machineId": "M1",
     "at": "2026-11-18T12:00:00Z",
     "started": true
    }
   ]
  },
  {
   "why": "nothing to land on: another machine, before any send, or not a result",
   "steps": [
    {
     "mark": {
      "machineId": "M9",
      "at": "2026-11-18T14:00:00Z",
      "result": "finished",
      "source": "printer"
     },
     "changed": false
    },
    {
     "mark": {
      "machineId": "M1",
      "at": "2026-11-18T07:00:00Z",
      "result": "finished",
      "source": "printer"
     },
     "changed": false
    },
    {
     "mark": {
      "machineId": "M1",
      "at": "2026-11-18T14:00:00Z",
      "result": "ok",
      "source": "printer"
     },
     "changed": false
    },
    {
     "mark": {
      "machineId": "M1",
      "at": "2026-11-18T14:00:00Z",
      "result": "finished",
      "source": "guess"
     },
     "changed": false
    }
   ],
   "want": [
    {
     "machineId": "M1",
     "at": "2026-11-18T08:00:00Z",
     "started": true
    },
    {
     "machineId": "M2",
     "at": "2026-11-18T09:00:00Z",
     "started": true
    },
    {
     "machineId": "M1",
     "at": "2026-11-18T12:00:00Z",
     "started": true
